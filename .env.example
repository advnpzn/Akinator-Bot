# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Cloudflare challenge solver (TRAWL / FlareSolverr v2 compatible)
# Host local:  http://127.0.0.1:8193
# Public:      https://trawl.advnpzn.dev
# Docker→host: http://host.docker.internal:8193
SOLVER_URL=http://127.0.0.1:8193
AKIPY_SOLVER_URL=http://127.0.0.1:8193
SOLVER_TIMEOUT_MS=90000

# SQLite path
DATABASE_PATH=data/akinator.db

# Comma-separated Telegram user IDs for /admin
ADMIN_IDS=1746558682

# Optional shared secret: /admin <secret> unlocks admin for that chat session
ADMIN_SECRET=

LOG_LEVEL=INFO
# LOG_FILE=data/bot.log

# Concurrency / sessions
SESSION_TTL_SECONDS=1800
MAX_CONCURRENT_GAMES=500
MAX_CONCURRENT_AKI_CALLS=32

# Akinator defaults
DEFAULT_LANGUAGE=en
DEFAULT_CHILD_MODE=true
# c=characters, a=animals, o=objects
GAME_THEME=c

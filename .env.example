# Obtain from @BotFather. Never commit your .env file.
BOT_TOKEN=
# Optional alternative for a mounted secret file: BOT_TOKEN_FILE=/run/secrets/bot_token

# Leave empty for direct Akinator access. Configure a reachable solver only if needed.
# In Docker, 127.0.0.1 refers to the bot container, not your Pi host.
SOLVER_URL=
SOLVER_TIMEOUT_MS=60000
DATABASE_PATH=data/akinator.db
# Your own Telegram user IDs. Admin access is restricted to private chats.
ADMIN_IDS=
LOG_LEVEL=INFO
# Optional rotated local log file; Docker already rotates stdout logs.
# LOG_FILE=data/bot.log

# Pi-first admission and resource limits. These are ceilings, not reservations.
MAX_CONCURRENT_GAMES=100
MAX_CONCURRENT_AKI_CALLS=4
MAX_CONCURRENT_UPDATES=16
SESSION_TTL_SECONDS=1200
ACTION_TIMEOUT_SECONDS=120
ADMISSION_TIMEOUT_SECONDS=2
TELEGRAM_POOL_SIZE=16
TELEGRAM_REQUESTS_PER_SECOND=20
MEDIA_CACHE_BYTES=4194304
MEDIA_MAX_BYTES=2097152
EVENT_RETENTION_DAYS=30
BOT_CPUS=1.0
BOT_MEMORY=512m

DEFAULT_LANGUAGE=en
DEFAULT_CHILD_MODE=true
GAME_THEME=c
# Enable for one deployment to register the menu, then turn off again.
REGISTER_COMMANDS=false
